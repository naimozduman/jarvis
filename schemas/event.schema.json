{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/event.schema.json",
  "title": "Normalized JARVIS Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "idempotencyKey",
    "userId",
    "source",
    "type",
    "occurredAt",
    "receivedAt",
    "payload",
    "sensitivity"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "channel"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "web",
            "evolution",
            "telegram",
            "google",
            "plaid",
            "whoop",
            "healthkit",
            "iron_intervals",
            "nutrition",
            "system",
            "admin"
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "web_chat",
            "whatsapp",
            "telegram",
            "email",
            "calendar",
            "finance",
            "health",
            "training",
            "nutrition",
            "scheduler",
            "admin"
          ]
        },
        "connectionId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "providerEventId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "providerCursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      }
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user",
            "agent",
            "provider",
            "system",
            "external_person"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "required": [
        "kind"
      ]
    },
    "payload": {
      "type": "object"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "normal",
        "private",
        "sensitive",
        "restricted"
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "remoteIpHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "signatureVerified": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
