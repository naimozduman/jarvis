{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/connector-manifest.schema.json",
  "title": "JARVIS Connector Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "category",
    "capabilities",
    "auth",
    "sync",
    "dataSensitivity"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,64}$"
    },
    "displayName": {
      "type": "string",
      "maxLength": 100
    },
    "category": {
      "type": "string",
      "enum": [
        "messaging",
        "email",
        "calendar",
        "finance",
        "health",
        "training",
        "nutrition",
        "executor",
        "storage"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "write_internal",
          "write_external",
          "webhook",
          "poll",
          "oauth",
          "disconnect",
          "reconcile",
          "media"
        ]
      },
      "uniqueItems": true
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "requiredScopes"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "none",
            "api_key",
            "oauth2",
            "session",
            "service_token"
          ]
        },
        "requiredScopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "pkce": {
          "type": "boolean"
        },
        "refreshTokens": {
          "type": "boolean"
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "webhook",
            "poll",
            "webhook_and_reconcile",
            "manual"
          ]
        },
        "reconcileIntervalMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "cursorType": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "dataSensitivity": {
      "type": "string",
      "enum": [
        "normal",
        "private",
        "sensitive",
        "restricted"
      ]
    },
    "requiresApprovalForWrites": {
      "type": "boolean"
    },
    "productionReady": {
      "type": "boolean"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    }
  }
}
