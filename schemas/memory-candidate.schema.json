{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/memory-candidate.schema.json",
  "title": "JARVIS Memory Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "statement",
    "sourceRef",
    "confidence",
    "sensitivity",
    "confirmationRequired"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "permanent_fact",
        "constitution",
        "preference",
        "person_relationship",
        "project",
        "commitment",
        "historical_event",
        "observation",
        "hypothesis",
        "open_loop",
        "daily_state",
        "personality_preference",
        "conflict"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "message",
            "event",
            "email",
            "calendar",
            "finance",
            "health",
            "training",
            "nutrition",
            "user_confirmation",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 512
        },
        "quoteHash": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "normal",
        "private",
        "sensitive",
        "restricted"
      ]
    },
    "confirmationRequired": {
      "type": "boolean"
    },
    "validFrom": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reviewAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "relatedEntityIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true,
      "maxItems": 30
    },
    "supersedesId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "evidenceCount": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object"
    }
  }
}
