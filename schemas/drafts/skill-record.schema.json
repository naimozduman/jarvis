{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.invalid/contracts/skill-record/1.0.0-draft",
  "title": "Procedural Memory Record",
  "description": "V4 candidate contract. Not active in the JARVIS runtime. Promotion requires SCHEMA_EVOLUTION and registry evidence.",
  "x-contract-id": "jarvis.skill-record",
  "x-contract-version": "1.0.0-draft",
  "x-lifecycle": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillId",
    "version",
    "name",
    "purpose",
    "status",
    "procedure",
    "requiredCapabilities",
    "verification",
    "sourceRefs",
    "reviewEvidenceRef",
    "reviewAt",
    "grantsAuthority"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "skillId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "stale",
        "superseded",
        "disabled"
      ]
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{2,159}$"
      },
      "minItems": 0,
      "maxItems": 50,
      "uniqueItems": true
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "https://jarvis.invalid/contracts/source-reference/1.0.0-draft"
      },
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true
    },
    "reviewEvidenceRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewAt": {
      "type": "string",
      "format": "date-time"
    },
    "grantsAuthority": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "reviewEvidenceRef": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          }
        }
      }
    }
  ]
}
