{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.invalid/contracts/capability/1.0.0-draft",
  "title": "Capability Definition",
  "description": "V4 candidate contract. Not active in the JARVIS runtime. Promotion requires SCHEMA_EVOLUTION and registry evidence.",
  "x-contract-id": "jarvis.capability",
  "x-contract-version": "1.0.0-draft",
  "x-lifecycle": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "description",
    "risk",
    "inputSchemaId",
    "requiredScopes",
    "reversibility",
    "authorityRequirement",
    "sensitivity"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,159}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "risk": {
      "type": "string",
      "enum": [
        "READ",
        "LOW_RISK_INTERNAL",
        "CONTROLLED_WRITE",
        "HIGH_IMPACT",
        "PROHIBITED"
      ]
    },
    "inputSchemaId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "requiredScopes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{2,159}$"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "reversibility": {
      "type": "string",
      "enum": [
        "reversible",
        "partially_reversible",
        "irreversible",
        "unknown"
      ]
    },
    "authorityRequirement": {
      "type": "string",
      "enum": [
        "policy",
        "approval_or_finite_lease",
        "action_approval",
        "denied"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "normal",
        "private",
        "sensitive",
        "restricted"
      ]
    }
  }
}
