# JARVIS starts provider-free. Keep Evolution disabled unless an operator has completed the
# documented, fail-closed version, licence, private-network, and pairing gates.
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
USER_TIMEZONE=America/Chicago
ALLOWED_USER_EMAIL=
DATABASE_URL=
JARVIS_TEST_DATABASE_URL=
ENCRYPTION_KEY_CURRENT=
ENCRYPTION_KEY_VERSION=1
INTERNAL_SERVICE_TOKEN_PEPPER=
API_PORT=4000
WORKER_HEALTH_PORT=4100
PROVIDER_INTEGRATIONS_ENABLED=false
JARVIS_EVOLUTION_ENABLED=false
JARVIS_OWNER_ID=
JARVIS_WHATSAPP_INSTANCE=
JARVIS_OWNER_PHONE=
# Optional and only after authenticated admin enrollment; never infer an owner LID from a webhook.
JARVIS_OWNER_WHATSAPP_LID=
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_PROVIDER_BUILD_ID=
EVOLUTION_BAILEYS_VERSION=
EVOLUTION_IMAGE_DIGEST=
EVOLUTION_ALLOW_UNSTABLE_SOURCE_BUILD=false
EVOLUTION_WEBHOOK_MAX_BODY_BYTES=65536
# The OpenAI adapter is optional. Absence of a key produces an explicit not_configured result;
# CI and normal provider-free development must not set one.
OPENAI_API_KEY=
JARVIS_OPENAI_FAST_MODEL=gpt-5.6-luna
JARVIS_OPENAI_STANDARD_MODEL=gpt-5.6-terra
JARVIS_OPENAI_DEEP_MODEL=gpt-5.6-sol
JARVIS_OPENAI_FAST_REASONING_EFFORT=low
JARVIS_OPENAI_STANDARD_REASONING_EFFORT=medium
JARVIS_OPENAI_DEEP_REASONING_EFFORT=high
JARVIS_OPENAI_FAST_VERBOSITY=low
JARVIS_OPENAI_STANDARD_VERBOSITY=low
JARVIS_OPENAI_DEEP_VERBOSITY=medium
JARVIS_OPENAI_FAST_MAX_OUTPUT_TOKENS=1500
JARVIS_OPENAI_STANDARD_MAX_OUTPUT_TOKENS=2500
JARVIS_OPENAI_DEEP_MAX_OUTPUT_TOKENS=4000
JARVIS_BRAIN_MAX_CONTEXT_RECORDS=32
JARVIS_BRAIN_MAX_RECENT_MESSAGES=12
JARVIS_BRAIN_MAX_APPROX_PROMPT_TOKENS=6000
JARVIS_BRAIN_MAX_MODEL_CALLS_PER_CYCLE=1
JARVIS_BRAIN_DAILY_MODEL_SPEND_LIMIT_USD=10
JARVIS_BRAIN_DAILY_DEEP_CALL_LIMIT=8
JARVIS_BRAIN_DEEP_ESCALATION_ENABLED=false
JARVIS_BRAIN_DAILY_PROACTIVE_MESSAGE_MIN=6
JARVIS_BRAIN_DAILY_PROACTIVE_MESSAGE_MAX=9
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_DATABASE_CONNECTION_URI=
# Local compose `evolution` profile only. Supply an immutable reviewed source-build digest after
# completing docs/EVOLUTION_VERSION_GATE.md; the committed compose default intentionally cannot run.
EVOLUTION_SOURCE_IMAGE=
