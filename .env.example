# JARVIS starts provider-free. Keep Evolution disabled unless an operator has completed the
# documented, fail-closed version, licence, private-network, and pairing gates.
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
USER_TIMEZONE=America/Chicago
ALLOWED_USER_EMAIL=
# Runtime only: Vercel uses a separate server-only pooled Neon URL for neondb. Never reuse the
# migrations-only URL removed after manual staging migration work.
DATABASE_URL=
JARVIS_TEST_DATABASE_URL=
ENCRYPTION_KEY_CURRENT=
ENCRYPTION_KEY_VERSION=1
INTERNAL_SERVICE_TOKEN_PEPPER=
# The historical Railway runtime also supplied PORT. Phase 3.6 Vercel functions do not listen on
# a port; API_PORT and WORKER_HEALTH_PORT remain local/historical-runtime fallbacks only.
PORT=
API_PORT=4000
WORKER_HEALTH_PORT=4100
# Optional staging-only bearer credential for POST /internal/staging/synthetic-turn. Set only as a
# platform secret; no public route is registered when this or JARVIS_OWNER_ID is absent.
STAGING_RUNTIME_TEST_TOKEN=
PROVIDER_INTEGRATIONS_ENABLED=false
JARVIS_EVOLUTION_ENABLED=false
JARVIS_OWNER_ID=
JARVIS_WHATSAPP_INSTANCE=
JARVIS_OWNER_PHONE=
# Optional and only after authenticated admin enrollment; never infer an owner LID from a webhook.
JARVIS_OWNER_WHATSAPP_LID=
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_PROVIDER_BUILD_ID=
EVOLUTION_BAILEYS_VERSION=
EVOLUTION_IMAGE_DIGEST=
EVOLUTION_ALLOW_UNSTABLE_SOURCE_BUILD=false
EVOLUTION_WEBHOOK_MAX_BODY_BYTES=65536
# The OpenAI adapter is optional. Absence of a key produces an explicit not_configured result;
# CI and normal provider-free development must not set one.
OPENAI_API_KEY=
# Phase 3.6B Vercel Free Tier architecture. With JARVIS_ZERO_COST_MODE=true, direct OpenAI and
# any AI_GATEWAY_API_KEY are rejected. Eligibility is Vercel's current public catalog `tags` value
# `free`, never a model suffix, provider name, zero price, or cache price. Vercel injects OIDC;
# never set a real token locally or commit one.
JARVIS_MODEL_PROVIDER=openai-responses
JARVIS_ZERO_COST_MODE=false
# Vercel currently includes $5/month. Default $3 preserves a 40% reconciliation margin; schema
# caps it at $4. The snapshot pair is server-only and missing/stale accounting fails closed.
JARVIS_ZERO_COST_MONTHLY_CREDIT_GUARD_USD=3
JARVIS_ZERO_COST_REPORTED_MONTHLY_USAGE_USD=
JARVIS_ZERO_COST_REPORTED_MONTHLY_USAGE_AS_OF=
VERCEL_OIDC_TOKEN=
AI_GATEWAY_API_KEY=
JARVIS_VERCEL_AI_GATEWAY_FAST_MODEL=
JARVIS_VERCEL_AI_GATEWAY_STANDARD_MODEL=
JARVIS_VERCEL_AI_GATEWAY_DEEP_MODEL=
# Copy this only from a successful, same-deployment `pnpm zero-cost:verify-models` result. An
# empty value fails closed as not_configured; do not guess values from provider/model names.
JARVIS_ZERO_COST_VERIFIED_MODEL_IDS=
# A nonzero list rate can be Free Tier eligible. These rates are pessimistic credit-guard bounds,
# not eligibility evidence. A configured route requires both input/output values; partial/missing
# values fail closed. Do not configure a route or snapshot in this repository pass.
JARVIS_VERCEL_AI_GATEWAY_FAST_INPUT_COST_PER_MILLION=
JARVIS_VERCEL_AI_GATEWAY_FAST_OUTPUT_COST_PER_MILLION=
JARVIS_VERCEL_AI_GATEWAY_STANDARD_INPUT_COST_PER_MILLION=
JARVIS_VERCEL_AI_GATEWAY_STANDARD_OUTPUT_COST_PER_MILLION=
JARVIS_VERCEL_AI_GATEWAY_DEEP_INPUT_COST_PER_MILLION=
JARVIS_VERCEL_AI_GATEWAY_DEEP_OUTPUT_COST_PER_MILLION=
# Opaque-only Convex orchestration. These are separate server/local secrets and are intentionally
# blank during provider-free repository verification.
JARVIS_CONVEX_ORCHESTRATION_URL=
JARVIS_VERCEL_TO_CONVEX_SECRET=
JARVIS_CONVEX_TO_VERCEL_SECRET=
# Local bridge boundary. Enabling this does not start Evolution or pair WhatsApp. The owner target
# must be a locally derived `evo:owner-target:<sha256>` digest, never a phone number or JID.
JARVIS_LOCAL_BRIDGE_ENABLED=false
JARVIS_LOCAL_BRIDGE_TOKEN=
JARVIS_LOCAL_BRIDGE_OWNER_ID=
JARVIS_LOCAL_BRIDGE_CONNECTION_ID=
JARVIS_LOCAL_BRIDGE_OWNER_TARGET_REFERENCE=
JARVIS_OPENAI_FAST_MODEL=gpt-5.6-luna
JARVIS_OPENAI_STANDARD_MODEL=gpt-5.6-terra
JARVIS_OPENAI_DEEP_MODEL=gpt-5.6-sol
JARVIS_OPENAI_FAST_REASONING_EFFORT=low
JARVIS_OPENAI_STANDARD_REASONING_EFFORT=medium
JARVIS_OPENAI_DEEP_REASONING_EFFORT=high
JARVIS_OPENAI_FAST_VERBOSITY=low
JARVIS_OPENAI_STANDARD_VERBOSITY=low
JARVIS_OPENAI_DEEP_VERBOSITY=medium
JARVIS_OPENAI_FAST_MAX_OUTPUT_TOKENS=1500
JARVIS_OPENAI_STANDARD_MAX_OUTPUT_TOKENS=2500
JARVIS_OPENAI_DEEP_MAX_OUTPUT_TOKENS=4000
JARVIS_BRAIN_MAX_CONTEXT_RECORDS=32
JARVIS_BRAIN_MAX_RECENT_MESSAGES=12
JARVIS_BRAIN_MAX_APPROX_PROMPT_TOKENS=6000
JARVIS_BRAIN_MAX_MODEL_CALLS_PER_CYCLE=1
JARVIS_BRAIN_DAILY_MODEL_SPEND_LIMIT_USD=10
JARVIS_BRAIN_DAILY_DEEP_CALL_LIMIT=8
JARVIS_BRAIN_DEEP_ESCALATION_ENABLED=false
JARVIS_BRAIN_DAILY_PROACTIVE_MESSAGE_MIN=6
JARVIS_BRAIN_DAILY_PROACTIVE_MESSAGE_MAX=9
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_DATABASE_CONNECTION_URI=
# Local compose `evolution` profile only. Supply an immutable reviewed source-build digest after
# completing docs/EVOLUTION_VERSION_GATE.md; the committed compose default intentionally cannot run.
EVOLUTION_SOURCE_IMAGE=

# Private owner apps. HTTPS origins only, no path. Set each URL/TOKEN pair together.
# These credentials are server-only and must never use a NEXT_PUBLIC_ prefix.
# App owners control scopes, revocation and rotation. Replace tokens here after rotation.
OURHOURS_API_URL=
OURHOURS_API_TOKEN=
GROWTH_API_URL=
GROWTH_API_TOKEN=
IRON_API_URL=
IRON_API_TOKEN=

# Independent read-only gateway auth, never reuse WhatsApp or Convex credentials.
# Requires JARVIS_OWNER_ID for canonical audit and a global 30 reads/minute limit.
JARVIS_PERSONAL_SYSTEM_READ_TOKEN=
# Temporary overlap during rotation. Remove old token and redeploy to revoke it.
JARVIS_PERSONAL_SYSTEM_READ_TOKEN_NEXT=
