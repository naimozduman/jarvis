{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JARVIS Skill Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillId",
    "version",
    "name",
    "purpose",
    "status",
    "procedure",
    "requiredCapabilities",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "skillId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "purpose": {
      "type": "string",
      "maxLength": 1200
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "stale",
        "superseded",
        "disabled"
      ]
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 100
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 30
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "source-reference.schema.json"
      },
      "maxItems": 50
    },
    "lastVerifiedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersedesSkillId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
