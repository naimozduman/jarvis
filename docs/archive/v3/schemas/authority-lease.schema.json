{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JARVIS Authority Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "leaseId",
    "ownerId",
    "capability",
    "scope",
    "startsAt",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "leaseId": {
      "type": "string",
      "format": "uuid"
    },
    "ownerId": {
      "type": "string",
      "format": "uuid"
    },
    "capability": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "startsAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expired",
        "revoked",
        "consumed"
      ]
    },
    "amountLimit": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "targetAllowlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 100
    },
    "sourceApprovalId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
