{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JARVIS World State Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ownerId",
    "kind",
    "observedAt",
    "expiresAt",
    "sourceRef",
    "value"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ownerId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRef": {
      "$ref": "source-reference.schema.json"
    },
    "value": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
