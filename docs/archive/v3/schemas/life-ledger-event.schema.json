{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JARVIS Life Ledger Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ledgerEventId",
    "ownerId",
    "kind",
    "startedAt",
    "sourceRefs",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ledgerEventId": {
      "type": "string",
      "format": "uuid"
    },
    "ownerId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "source-reference.schema.json"
      },
      "minItems": 1,
      "maxItems": 50
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "normal",
        "private",
        "sensitive",
        "restricted"
      ]
    },
    "episodeId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
