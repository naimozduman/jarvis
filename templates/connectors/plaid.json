{
  "schemaVersion": 1,
  "id": "plaid",
  "displayName": "Plaid Finance",
  "category": "finance",
  "capabilities": [
    "read",
    "webhook",
    "poll",
    "oauth",
    "disconnect",
    "reconcile"
  ],
  "auth": {
    "type": "oauth2",
    "requiredScopes": [
      "transactions",
      "balance",
      "liabilities"
    ],
    "pkce": false,
    "refreshTokens": false
  },
  "sync": {
    "strategy": "webhook_and_reconcile",
    "reconcileIntervalMinutes": 360,
    "cursorType": "transactions-sync-cursor"
  },
  "dataSensitivity": "restricted",
  "requiresApprovalForWrites": true,
  "productionReady": false,
  "notes": "Read-only. Chase and selected Mercury accounts only. Do not add transfer or payment products."
}
