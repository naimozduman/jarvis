{
  "schemaVersion": 1,
  "id": "whoop",
  "displayName": "WHOOP",
  "category": "health",
  "capabilities": [
    "read",
    "webhook",
    "poll",
    "oauth",
    "disconnect",
    "reconcile"
  ],
  "auth": {
    "type": "oauth2",
    "requiredScopes": [
      "offline",
      "read:recovery",
      "read:sleep",
      "read:workout",
      "read:cycles"
    ],
    "pkce": true,
    "refreshTokens": true
  },
  "sync": {
    "strategy": "webhook_and_reconcile",
    "reconcileIntervalMinutes": 360,
    "cursorType": "provider-updated-at-window"
  },
  "dataSensitivity": "restricted",
  "requiresApprovalForWrites": true,
  "productionReady": false,
  "notes": "Verify webhook signatures against raw bytes and keep health recommendations evidence-based."
}
