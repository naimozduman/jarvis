# Keep repository text consistent across Windows and Unix worktrees.
* text=auto eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Do not normalize binary assets as text.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.pdf -text
*.zip -text
*.gz -text
*.woff -text
*.woff2 -text
*.ttf -text
*.mp3 -text
*.mp4 -text
*.webm -text
